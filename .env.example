# ==============================================
# Padhaku Portal - Environment Example
# ==============================================

# Custom API Base URL (Defaults to '/api')
VITE_API_URL=/api

# Google Gemini AI Key (Used for AI Tutor)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Authentication & Web SDK
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_AUTH_DOMAIN=padhakuportal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=padhakuportal
VITE_FIREBASE_STORAGE_BUCKET=padhakuportal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=690270107032
