{
  "name": "padhakuportal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/optimize-images.mjs && node scripts/build_sitemap.js && vite build && node scripts/post-build.js && node scripts/verify-build.js",
    "preview": "vite preview",
    "dev:api": "wrangler pages dev dist --compatibility-date=2024-03-01 --port 8788",
    "dev:api:remote": "wrangler pages dev dist --compatibility-date=2024-03-01 --port 8788",
    "start": "npm run build && concurrently \"npm run dev\" \"npm run dev:api\"",
    "start:remote": "concurrently \"npm run dev\" \"npm run dev:api:remote\"",
    "verify:preview": "node scripts/verify-preview.js",
    "test:cache-purge": "npx tsx scripts/test-cache-purge-scope.ts",
    "deploy": "node scripts/deploy-pipeline.js",
    "db:seed": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "db:branches": "wrangler d1 execute DB --remote --command=\"SELECT name, slug FROM branches\"",
    "db:core:migrate:local": "wrangler d1 migrations apply PADHAKU_CORE_DB --local",
    "db:core:migrate:remote": "node scripts/safe-migrate-core.js --remote",
    "db:core:schema:remote": "wrangler d1 execute PADHAKU_CORE_DB --remote --file=./shiksha-core-schema.sql",
    "db:core:seed:local": "wrangler d1 execute PADHAKU_CORE_DB --local --file=./shiksha-core-seed-keydocs.sql",
    "db:core:seed:remote": "node scripts/safe-migrate-core.js --block-seed-remote",
    "db:core:tables": "wrangler d1 execute PADHAKU_CORE_DB --remote --command=\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE '_cf_%' ORDER BY name;\"",
    "keydocs:verify": "npx tsx -e \"import { verifyKeyDocs3System } from './scripts/verify-keydocs-3'; console.log('Running KeyDocs System Verification');\"",
    "keydocs:e2e": "npx tsx -e \"import { runKeyDocs3E2ESuite } from './scripts/e2e-keydocs-3'; console.log('Running KeyDocs E2E Suite');\"",
    "keydocs:audit": "npx tsx -e \"import { runKeyDocsProductionAudit } from './scripts/keydocs-production-audit'; console.log('Running KeyDocs Production Audit');\"",
    "keydocs:import": "npx tsx -e \"import { runImportCLI } from './scripts/keydocs-import'; console.log('Running KeyDocs Import Engine');\"",
    "keydocs:content-audit": "npx tsx -e \"import { runProductionContentAudit } from './scripts/keydocs-production-content-audit'; console.log('Running Content Quality Audit');\"",
    "keydocs:validate": "npx tsx -e \"import { runFullSystemValidation } from './scripts/keydocs-production-validation'; console.log('Running Full System Validation');\"",
    "db:audit": "npx tsx -e \"import { runDatabaseRepairAudit } from './scripts/database-repair-audit'; console.log('Running Database Integrity Audit');\"",
    "db:verify": "npx tsx -e \"import { verifyDatabaseFinal } from './scripts/verify-database-final'; console.log('Running Full Database Verification');\"",
    "db:repair:dry-run": "npx tsx -e \"import { runDatabaseRepairAudit } from './scripts/database-repair-audit'; runDatabaseRepairAudit({}, ['--dry-run']);\"",
    "db:repair:apply": "npx tsx -e \"import { runDatabaseRepairAudit } from './scripts/database-repair-audit'; runDatabaseRepairAudit({}, ['--apply-safe-fixes']);\"",
    "admin:identity-audit": "npx tsx -e \"import { runAdminIdentityAudit } from './scripts/audit-admin-identity'; console.log('Running Admin Identity Audit');\"",
    "admin:auth": "npx tsx scripts/verify-admin-auth.ts",
    "admin:verify-14": "npx tsx scripts/verify-all-14-admin-sections.ts",
    "admin:crud": "npx tsx -e \"import { runAdminCrudVerification } from './scripts/verify-admin-crud'; console.log('Running Admin CRUD Verification');\"",
    "admin:platform": "npx tsx -e \"import { verifyAdminPlatform } from './scripts/verify-admin-platform'; console.log('Running Admin Platform Verification');\"",
    "platform:audit": "npx tsx -e \"import { runPlatformIntegrityAudit } from './scripts/platform-integrity-audit'; runPlatformIntegrityAudit();\"",
    "platform:verify": "npx tsx -e \"import { runPlatformVerification } from './scripts/verify-platform-integration'; runPlatformVerification();\"",
    "teacher:audit": "npx tsx -e \"import { runTeacherIntegrityAudit } from './scripts/teacher-integrity-audit'; runTeacherIntegrityAudit();\"",
    "teacher:verify": "npx tsx -e \"import { runTeacherVerification } from './scripts/verify-teacher-integration'; runTeacherVerification();\"",
    "assessment:audit": "npx tsx -e \"import { runAssessmentIntegrityAudit } from './scripts/assessment-integrity-audit'; runAssessmentIntegrityAudit();\"",
    "assessment:verify": "npx tsx -e \"import { runAssessmentVerification } from './scripts/verify-assessment-integration'; runAssessmentVerification();\"",
    "ai:audit": "npx tsx -e \"import { runAiQualityEval } from './scripts/ai-quality-eval'; runAiQualityEval();\"",
    "ai:verify": "npx tsx -e \"import { runAiIntegrationVerify } from './scripts/ai-integration-verify'; runAiIntegrationVerify();\"",
    "pwa:audit": "npx tsx -e \"import { runPwaIntegrityAudit } from './scripts/pwa-integrity-audit'; runPwaIntegrityAudit();\"",
    "pwa:verify": "npx tsx -e \"import { runPwaVerification } from './scripts/verify-pwa-integration'; runPwaVerification();\"",
    "notifications:audit": "npx tsx -e \"import { runNotificationIntegrityAudit } from './scripts/notification-integrity-audit'; runNotificationIntegrityAudit();\"",
    "notifications:verify": "npx tsx -e \"import { runVerifyNotificationIntegration } from './scripts/verify-notification-integration'; runVerifyNotificationIntegration();\"",
    "monetization:audit": "npx tsx -e \"import { runMonetizationIntegrityAudit } from './scripts/monetization-integrity-audit'; runMonetizationIntegrityAudit();\"",
    "monetization:verify": "npx tsx -e \"import { runVerifyMonetizationIntegration } from './scripts/verify-monetization-integration'; runVerifyMonetizationIntegration();\"",
    "launch:audit": "npx tsx -e \"import { runProductionReadinessAudit } from './scripts/production-readiness-audit'; runProductionReadinessAudit();\"",
    "launch:verify": "npx tsx -e \"import { runVerifyProductionLaunch } from './scripts/verify-production-launch'; runVerifyProductionLaunch();\"",
    "golive:audit": "npx tsx -e \"import { runGoLiveAudit } from './scripts/go-live-audit'; runGoLiveAudit();\"",
    "golive:verify": "npx tsx -e \"import { runVerifyGoLiveExecution } from './scripts/verify-go-live-execution'; runVerifyGoLiveExecution();\"",
    "ops:report": "npx tsx -e \"import { generateOperationsReport } from './scripts/generate-operations-report'; generateOperationsReport();\"",
    "ops:health": "npx tsx -e \"import { runOperationsHealthCheck } from './scripts/operations-health-check'; runOperationsHealthCheck();\"",
    "payment:audit": "npx tsx -e \"import { runPaymentReconciliationAudit } from './scripts/payment-reconciliation-audit'; runPaymentReconciliationAudit();\"",
    "content:audit": "npx tsx -e \"import { runContentScaleAudit } from './scripts/content-scale-audit'; runContentScaleAudit();\"",
    "phase-q:verify": "npx tsx -e \"import { runVerifyPhaseQ } from './scripts/verify-phase-q'; runVerifyPhaseQ();\"",
    "users:audit": "npx tsx -e \"import { runUserIdentityAudit } from './scripts/user-identity-audit'; runUserIdentityAudit();\"",
    "users:integrity": "npx tsx -e \"import { runUserManagementIntegrityAudit } from './scripts/user-management-integrity-audit'; runUserManagementIntegrityAudit();\"",
    "users:verify": "npx tsx -e \"import { runVerifyUserManagement } from './scripts/verify-user-management'; runVerifyUserManagement();\"",
    "deploy:beta": "npx tsx scripts/deploy-beta.ts",
    "beta:audit": "npx tsx -e \"import { runBetaDeploymentAudit } from './scripts/beta-deployment-audit'; runBetaDeploymentAudit();\"",
    "beta:verify": "npx tsx -e \"import { runVerifyBetaDeployment } from './scripts/verify-beta-deployment'; runVerifyBetaDeployment();\"",
    "product:report": "npx tsx -e \"import { generateProductReport } from './scripts/generate-product-report'; generateProductReport();\"",
    "test:migration-safeguards": "node scripts/verify-migration-safeguards.js",
    "test:100days": "npx tsx scripts/verify-100-days-of-code.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.0",
    "@hookform/resolvers": "^5.0.1",
