    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.15.3",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "unpdf": "^1.8.1",
