    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.28.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.12",
    "rollup-plugin-visualizer": "^7.0.1",
